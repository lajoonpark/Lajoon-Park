---
import Base from '../layouts/Base.astro';
import { getGithub } from '../lib/github';
import { activity, ago, longDate, monthYear, num } from '../lib/format';
import { displayNames, site } from '../data/site';
import { projects } from '../data/projects';

const gh = await getGithub();
const act = activity(gh.contributions.weeks, gh.createdAt, gh.fetchedAt);
const profile = `https://github.com/${gh.login}`;
const year = new Date(gh.fetchedAt).getUTCFullYear();

const shown = (name: string) => displayNames[name] ?? name;

// Match each featured project to its live repo, trying the listed names in order.
const featured = projects.map((p) => {
  const repo = p.repos.map((n) => gh.repos.find((r) => r.name.toLowerCase() === n.toLowerCase())).find(Boolean);
  const href = repo ? (p.branch ? `${repo.url}/tree/${p.branch}` : repo.url) : profile;
  return { ...p, repo, href, language: repo?.language ?? p.language };
});

const lastPush = gh.repos[0];
const recent = gh.repos.slice(0, 6);

const totalBytes = gh.languages.reduce((n, l) => n + l.bytes, 0);
const langs = gh.languages.slice(0, 7).map((l, i) => ({
  ...l,
  pct: (l.bytes / totalBytes) * 100,
  tone: 100 - i * 13,
}));

const ringPct = Math.round((act.active / act.total) * 100);
---

<Base
  title={`${site.name} — ${site.role}`}
  description={`${site.lede} ${gh.publicRepos} public repos, ${num(gh.contributions.total)} contributions in the last year.`}
>
  <header class="ag-site-header">
    <a class="ag-logo" href="#top">{site.name}</a>
    <nav class="ag-nav" id="ag-site-nav" aria-label="Main">
      <a class="ag-link" href="#projects">Projects</a>
      <a class="ag-link" href="#figures">Figures</a>
      <a class="ag-link" href="#activity">Activity</a>
      <a class="ag-link" href="#contact">Contact</a>
    </nav>
    <div class="ag-header-end">
      <span class="ag-mono ag-header-date">Updated {longDate(gh.fetchedAt)}</span>
      <a class="ag-btn ag-btn--sm" href={profile}>GitHub</a>
      <button class="ag-menu-btn" type="button" aria-expanded="false" aria-controls="ag-site-nav"
        ><span class="ag-menu-lines" aria-hidden="true"></span><span class="ag-sr">Menu</span></button
      >
    </div>
  </header>

  <main id="top">
    <section class="ag-hero">
      <div class="ag-hero-frame">
        <div class="ag-hero-photo">
          <canvas class="ag-art ag-hero-base" data-ag-art="silk" data-ag-pal="night" data-ag-seed="7" data-ag-gain=".55" data-ag-scale=".5" role="img" aria-label="Dark satin surface catching a soft light"></canvas>
          <canvas class="ag-art" data-ag-art="none" data-ag-seed="7" data-ag-live aria-hidden="true"></canvas>
        </div>
        <div class="ag-hero-shade" aria-hidden="true"></div>
        <div class="ag-grain" aria-hidden="true"></div>
      </div>
      <div class="ag-hero-inner">
        <div class="ag-hero-top">
          <p class="ag-wordmark" style={`--ag-len:${site.name.length}`}>{site.name}</p>
          <p class="ag-hero-studio">{site.role} <span class="ag-it">’{String(year).slice(2)}</span></p>
          <p class="ag-live ag-mono"><i></i>Last push · <b>{ago(lastPush.pushedAt, gh.fetchedAt)}</b></p>
        </div>
        <div class="ag-hero-marks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="ag-hero-bottom">
          <h1 class="ag-hero-lede">{site.lede} <span>{site.ledeMuted}</span></h1>
          <ul class="ag-hero-list">
            {projects.map((p, i) => <li><span>0{i + 1}</span>{p.name}</li>)}
            <li><span>0{projects.length + 1}</span>{gh.publicRepos - projects.length} more on GitHub</li>
          </ul>
          <div class="ag-person">
            <div class="ag-person-photo">
              <canvas class="ag-art" data-ag-art="bust" data-ag-pal="bone" data-ag-seed="21" role="img" aria-label="Polished stone head sculpture, generated in code"></canvas>
            </div>
            <div class="ag-person-body">
              <p class="ag-person-role">{site.role} <span>github.com/{gh.login}</span></p>
              <p class="ag-person-name">{site.name}</p>
              <a class="ag-btn ag-btn--sm" href={profile}>Follow on GitHub</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="ag-work" id="projects">
      <div class="ag-sec-head ag-wrap">
        <div>
          <span class="ag-mono ag-sec-tag">Selected work</span>
          <h2 class="ag-title ag-dot">Cur<span class="ag-it">rent</span></h2>
        </div>
        <p class="ag-sec-lede">What I’m building right now. Stars, forks and release tags are read from GitHub on every rebuild.</p>
      </div>
      <div class="ag-work-grid ag-wrap">
        {featured.map((p, i) => (
          <a class={`ag-project${i === 0 ? ' ag-project--wide' : ''}`} href={p.href}>
            <div class="ag-project-media">
              <span class="ag-project-chip ag-mono">{p.status}{p.language ? ` · ${p.language}` : ''}</span>
              <canvas class="ag-art" data-ag-art={p.art.kind} data-ag-pal={p.art.palette} data-ag-seed={p.art.seed} role="img" aria-label={p.art.label}></canvas>
            </div>
            <div class="ag-project-meta">
              <h3 class="ag-project-name">{p.name}</h3>
              <p class="ag-project-kind">{p.kind}</p>
              <p class="ag-project-year">{p.year}</p>
            </div>
            <p class="lp-project-blurb">{p.blurb}</p>
            {p.repo && (
              <p class="lp-project-line ag-mono">
                <span>★ {p.repo.stars}</span>
                <span>⑂ {p.repo.forks}</span>
                {p.repo.release && <span>{p.repo.release.tag}</span>}
                {p.repo.releaseCount > 0 && <span>{p.repo.releaseCount} releases</span>}
                <span>pushed {ago(p.repo.pushedAt, gh.fetchedAt)}</span>
              </p>
            )}
          </a>
        ))}
      </div>
    </section>

    <section class="ag-results" id="figures">
      <div class="ag-sec-head ag-wrap">
        <h2 class="ag-h2">The year, <span class="ag-it">in figures</span>.</h2>
        <p class="ag-sec-lede">Public repositories only. Pulled from the GitHub API on {longDate(gh.fetchedAt)}.</p>
      </div>
      <div class="ag-bento ag-wrap">
        <article class="ag-tile ag-tile-case">
          <div class="ag-tile-photo"><canvas class="ag-art" data-ag-art="orb" data-ag-pal="night" data-ag-seed="61" aria-hidden="true"></canvas></div>
          <div class="ag-tile-case-in">
            <p class="ag-tile-label ag-mono">GitHub · live</p>
            <p class="ag-tile-brand">{site.name.split(' ')[0]} <span class="ag-it">{site.name.split(' ')[1]}</span></p>
            <p class="ag-tile-sub">On GitHub since {monthYear(gh.createdAt)}</p>
            <a class="ag-btn ag-btn--light ag-btn--sm" href={profile}>View profile</a>
          </div>
        </article>

        <article class="ag-tile ag-tile-figs">
          <div class="ag-fig"><p class="ag-fig-num">{num(gh.contributions.total)}</p><p class="ag-fig-label">Contributions in the last year</p></div>
          <div class="ag-fig"><p class="ag-fig-num">{num(gh.contributions.commits)}</p><p class="ag-fig-label">Commits, plus {gh.contributions.pullRequests} pull requests and {gh.contributions.issues} issues</p></div>
          <div class="ag-fig"><p class="ag-fig-num">{num(gh.releases)}</p><p class="ag-fig-label">Tagged releases across {gh.publicRepos} public repos</p></div>
          <dl class="lp-ledger">
            <div><dt class="ag-mono">Stars</dt><dd>{num(gh.stars)}</dd></div>
            <div><dt class="ag-mono">Forks</dt><dd>{num(gh.forks)}</dd></div>
            <div><dt class="ag-mono">Followers</dt><dd>{num(gh.followers)}</dd></div>
            <div><dt class="ag-mono">Repos</dt><dd>{num(gh.publicRepos)}</dd></div>
          </dl>
        </article>

        <article class="ag-tile ag-tile-ring">
          <div class="ag-ring-box">
            <svg class="ag-ring" viewBox="0 0 120 120" aria-hidden="true"><circle class="ag-ring-bg" cx="60" cy="60" r="52" pathLength="100" /><circle class="ag-ring-fg" style={`stroke-dashoffset:${100 - ringPct}`} cx="60" cy="60" r="52" pathLength="100" /></svg>
            <p class="ag-ring-num">{ringPct}</p>
          </div>
          <p class="ag-tile-title">% of days with a contribution</p>
          <p class="ag-tile-text">{act.active} active days out of {act.total} since joining. Longest streak: {act.longest} {act.longest === 1 ? 'day' : 'days'}.</p>
        </article>

        <article class="ag-tile ag-tile-bars">
          <div><p class="ag-fig-num">{num(act.sixMonthTotal)}</p><p class="ag-fig-label">Contributions over the last six months</p></div>
          <ul class="ag-bars">
            {act.months.map((m) => (
              <li style={`--ag-h:${m.h.toFixed(3)}`}><span class="ag-bar-val">{m.count}</span><span class="ag-bar"></span><span class="ag-bar-label">{m.label}</span></li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="lp-activity" id="activity">
      <div class="lp-panel">
        <div class="lp-panel-head">
          <h2 class="ag-h2">Fifty-two weeks, <span class="ag-it">in commits</span>.</h2>
          <p class="lp-panel-lede">{num(gh.contributions.total)} contributions. Each square is a day; the brighter the lime, the busier it was.</p>
        </div>

        <div class="lp-heat-scroll">
          <div class="lp-heat" role="img" aria-label={`Contribution calendar: ${num(gh.contributions.total)} contributions in the last year, ${act.active} active days`}>
            {gh.contributions.weeks.map((w) => (
              <div class="lp-heat-week" aria-hidden="true">
                {w.map((d) => <i class={`lp-cell lp-l${d.level}`} title={`${d.count} on ${longDate(d.date)}`}></i>)}
              </div>
            ))}
          </div>
        </div>
        <p class="lp-heat-key ag-mono" aria-hidden="true">Less <i class="lp-cell lp-l0"></i><i class="lp-cell lp-l1"></i><i class="lp-cell lp-l2"></i><i class="lp-cell lp-l3"></i><i class="lp-cell lp-l4"></i> More</p>

        <div class="lp-panel-cols">
          <div>
            <p class="lp-panel-h ag-mono">Languages · by bytes, public repos</p>
            <div class="lp-langbar" role="img" aria-label={`Languages: ${langs.map((l) => `${l.name} ${l.pct.toFixed(0)}%`).join(', ')}`}>
              {langs.map((l) => <span style={`flex:${l.pct};--tone:${l.tone}%`}></span>)}
            </div>
            <ul class="lp-langs">
              {langs.map((l) => (
                <li><i style={`--tone:${l.tone}%`}></i><span>{l.name}</span><span class="ag-mono">{l.pct < 1 ? '<1' : l.pct.toFixed(0)}%</span></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="lp-panel-h ag-mono">Recent pushes</p>
            <ul class="lp-recent">
              {recent.map((r) => (
                <li>
                  <a class="ag-link" href={r.url}>{shown(r.name)}</a>
                  <span class="ag-mono">{r.language ?? '—'}</span>
                  <span class="ag-mono">{ago(r.pushedAt, gh.fetchedAt)}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="ag-site-footer" id="contact">
    <div class="ag-foot-top ag-wrap">
      <div class="ag-foot-col"><p class="ag-foot-h ag-mono">Say hello</p><a class="ag-foot-big ag-link" href={`mailto:${site.email}`}>{site.email}</a></div>
      <nav class="ag-foot-col" aria-label="Footer"><p class="ag-foot-h ag-mono">Pages</p><a class="ag-link" href="#projects">Projects</a><a class="ag-link" href="#figures">Figures</a><a class="ag-link" href="#activity">Activity</a></nav>
      <div class="ag-foot-col"><p class="ag-foot-h ag-mono">Projects</p>{featured.map((p) => <a class="ag-link" href={p.href}>{p.name}</a>)}</div>
      <div class="ag-foot-col"><p class="ag-foot-h ag-mono">Elsewhere</p><a class="ag-link" href={profile}>GitHub</a><a class="ag-link" href={`${profile}?tab=repositories`}>All repositories</a></div>
    </div>
    <div class="ag-foot-mark-wrap"><p class="ag-foot-mark" style={`--ag-len:${site.name.length}`}>{site.name}</p></div>
    <div class="ag-foot-bottom ag-wrap">
      <p>© {year} {site.name}</p>
      <p class="ag-mono">Figures refreshed {longDate(gh.fetchedAt)} · imagery generated in code</p>
      <a class="ag-link" href={site.sourceRepo}>Source</a>
    </div>
  </footer>

  <script>
    // On narrow screens the heatmap scrolls sideways: start at the most recent weeks.
    const heat = document.querySelector('.lp-heat-scroll');
    if (heat) heat.scrollLeft = heat.scrollWidth;
  </script>
</Base>
